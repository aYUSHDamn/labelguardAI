# Copy to backend/.env and fill in. NEVER commit .env. The key never reaches the frontend.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Verify the current model name at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# low keeps thinking tokens (billed as output) down; empty = don't send a thinking config
GEMINI_THINKING_LEVEL=low

# Open Food Facts (read-only, no key needed). Identify your app politely.
OFF_USER_AGENT=LabelGuard/0.1 (student project; your-email@example.com)
OFF_ENABLED=1
# Set empty (OFF_COUNTRY_PARAM=) if India-filtered searches keep failing
OFF_COUNTRY_PARAM=countries_tags_en

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
